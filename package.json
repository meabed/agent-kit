{
  "name": "@meabed/skills",
  "version": "0.2.0",
  "description": "My reusable skills, commands, prompts, and agent instructions.",
  "homepage": "https://github.com/meabed/agent-kit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meabed/agent-kit.git"
  },
  "bin": {
    "skills": "./dist/cli.js"
  },
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    "agents",
    "commands",
    "dist",
    "docs",
    "prompts",
    "skills",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --target node --format esm --outfile dist/cli.js && chmod +x dist/cli.js",
    "dev": "bun src/cli.ts",
    "validate": "bun src/cli.ts validate",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "release": "semantic-release",
    "release:check": "bun scripts/check-release.ts",
    "release:dry": "semantic-release --dry-run --no-ci",
    "release:prepare": "bun scripts/stamp-version.ts",
    "prepack": "bun run build && bun run validate && bun run release:check"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "semantic-release": "^25.0.1"
  },
  "packageManager": "bun@1.3.14"
}
